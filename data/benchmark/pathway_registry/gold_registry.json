{
  "_meta": {
    "description": "Curated gold pathway registry for the perturbation benchmark. Each gold pathway is grounded to explicit RaMP pathwayRampIds unioned across sources (kegg/hmdb/reactome/wiki; pfocr and disease/regulatory name-variants excluded). Adjacency between pathways is computed automatically from the count of shared SPECIFIC (non-hub) metabolites, NOT hand-declared.",
    "ramp_db": "ramp.sqlite (RaMP-DB)",
    "thresholds": {
      "tau_exact": 0.9,
      "tau_containment": 0.7,
      "discriminative_max_pathways": 40,
      "k_specific": 2
    },
    "tier_rule": "EXACT: both-way full-set containment>=tau_exact. PARENT_CHILD: max full-set containment>=tau_containment. ADJACENT: share>=k_specific metabolites each present in <=discriminative_max_pathways pathways (hub metabolites excluded). else MISS. strict=EXACT+PARENT_CHILD; lenient adds ADJACENT.",
    "calibration_note": "k_specific=2 @ H=40 calibrated on gold-gold pairs: phe~tyr (4 shared: fumarylacetoacetate, 4-OH-phenylpyruvate...) and propanoate~BCAA (3 shared: methylmalonate, methylmalonyl-semialdehyde...) are ADJACENT; next pair shares <=1 -> clean gap. Shared specific metabolites are listed per adjacent verdict for auditability.",
    "excluded_pathway_name_substrings": [
      "diseas",
      "disorder",
      "biomarker",
      "cancer",
      "senescence",
      "resistance",
      "inhibitor",
      "regulat",
      "maturation",
      "invasi",
      "nutrient"
    ]
  },
